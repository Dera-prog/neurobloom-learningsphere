# --- Client (baked into the Vite build) -------------------------------------
# Safe to expose. Copy from Supabase → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server (Vercel functions only; never prefix with VITE_) ----------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Email ------------------------------------------------------------------
# Resend is used when its key is set, otherwise Mailgun.
# Verify the sending domain first; an unverified Resend account only delivers
# to its own address.
RESEND_API_KEY=
# Shared by both providers. Defaults to the provider's test sender.
EMAIL_FROM="NeuroBloom <hello@example.com>"
EMAIL_REPLY_TO=support@example.com

# --- Mailgun (fallback email provider) --------------------------------------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM="NeuroBloom <noreply@mg.example.com>"
# Optional: set for EU-region domains
# MAILGUN_BASE_URL=https://api.eu.mailgun.net/v3/your-domain/messages
# Optional: replies go here
# MAILGUN_REPLY_TO=support@example.com

# --- Termii (SMS for guardian sign-up codes) --------------------------------
TERMII_API_KEY=
# Optional overrides
# TERMII_SENDER_ID=NeuroBloom
# TERMII_CHANNEL=generic
# TERMII_BASE_URL=https://api.ng.termii.com
