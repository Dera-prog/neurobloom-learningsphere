# --- Client (baked into the Vite build) -------------------------------------
# Safe to expose. Copy from Supabase → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server (Vercel functions only; never prefix with VITE_) ----------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Mailgun ----------------------------------------------------------------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM="NeuroBloom <noreply@mg.example.com>"
# Optional: set for EU-region domains
# MAILGUN_BASE_URL=https://api.eu.mailgun.net/v3/your-domain/messages
# Optional: replies go here
# MAILGUN_REPLY_TO=support@example.com
